# Somente backend/runner. Nunca use estas variáveis no bundle Vite do cliente.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_SUBSTITUA_NO_AMBIENTE

# Token administrativo próprio para os endpoints POST (mínimo 16 caracteres).
PDDE_API_COMMAND_TOKEN=substitua-por-token-aleatorio-longo

# Diretório transitório do runner; evidências institucionais ficam no Storage.
PDDE_WORKSPACE_PATH=/var/lib/pdde-repasse-conciliador
PDDE_WORKER_ID=runner-pdde-01
PDDE_WORKER_LEASE_SECONDS=300
PDDE_WORKER_HEARTBEAT_MS=100000
PDDE_WORKER_POLL_MS=5000

HOST=0.0.0.0
PORT=3000
# Prazo para respostas ativas terminarem após SIGTERM/SIGINT (1–120 segundos).
PDDE_API_SHUTDOWN_MS=30000
