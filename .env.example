# Somente backend/runner. Nunca use estas variáveis no bundle Vite do cliente.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_SUBSTITUA_NO_AMBIENTE

# Token administrativo opaco para os endpoints POST (mínimo 32 caracteres ASCII, sem espaços).
# Exemplo de geração: openssl rand -base64 32
PDDE_API_COMMAND_TOKEN=substitua-por-token-aleatorio-com-pelo-menos-32-caracteres

# Diretório transitório do executor; evidências institucionais ficam no Storage.
PDDE_WORKSPACE_PATH=/var/lib/pdde-repasse-conciliador
# Intervalo de consulta da fila simples. Há somente uma tarefa ativa por vez.
PDDE_WORKER_POLL_MS=5000

# Orquestração durável opcional. O padrão continua sendo a fila Supabase/Postgres.
# O SDK do Inngest utiliza INNGEST_EVENT_KEY e INNGEST_SIGNING_KEY quando a integração for publicada.
INNGEST_ENABLED=false
INNGEST_APP_ID=pdde-4cre
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

HOST=0.0.0.0
PORT=3000
# Prazo para respostas ativas terminarem após SIGTERM/SIGINT (1–120 segundos).
PDDE_API_SHUTDOWN_MS=30000
